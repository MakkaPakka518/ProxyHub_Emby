  "components": [
    {"name":"Primary action","kind":"button","refersTo":"button-primary","description":"Main copper action.","html":"<button class=\"ds-primary\">添加节点</button>","css":".ds-primary{background:var(--primary,#b74424);color:var(--on-primary,#fff);padding:11px 18px;min-height:42px;border:0;border-radius:12px;font:550 13px system-ui;cursor:pointer}.ds-primary:hover{filter:brightness(.95)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:2px solid var(--primary,#b74424);outline-offset:4px}"},
    {"name":"Stage action","kind":"button","refersTo":"stage-action","description":"High-contrast copy action on the navy stage.","html":"<button class=\"ds-stage-action\">复制入口</button>","css":".ds-stage-action{background:var(--stage-button,#fff0e6);color:var(--stage-button-text,#74361e);padding:10px 15px;min-height:44px;border:0;border-radius:12px;font:550 12px system-ui;cursor:pointer}.ds-stage-action:hover{background:#fff7f1}.ds-stage-action:active{transform:scale(.97)}.ds-stage-action:focus-visible{outline:2px solid var(--primary,#b74424);outline-offset:4px}"},
    {"name":"Search","kind":"input","refersTo":"input","description":"Readable search with explicit label and focus.","html":"<input class=\"ds-input\" aria-label=\"搜索节点\" placeholder=\"搜索节点、后缀或线路\">","css":".ds-input{background:var(--card,#fff);color:var(--text,#202d40);padding:11px 12px;border:1px solid var(--border-strong,#a8b3c2);border-radius:10px;font:14px system-ui;max-width:100%}.ds-input:focus-visible{outline:2px solid var(--primary,#b74424);outline-offset:4px}@media(max-width:760px){.ds-input{font-size:16px}}"},
    {"name":"Segment navigation","kind":"nav","refersTo":"navigation","description":"Current section remains explicitly selected.","html":"<nav class=\"ds-nav\" aria-label=\"主导航\"><button aria-current=\"page\">节点</button><button>测速与DNS</button><button>控制面板</button></nav>","css":".ds-nav{display:flex;gap:4px;padding:4px;border-radius:14px;background:var(--bg-soft,#eeeff2)}.ds-nav button{padding:8px 16px;min-height:38px;border:0;border-radius:11px;background:transparent;color:var(--text-sec,#596579);font:550 12px system-ui;cursor:pointer}.ds-nav button[aria-current=page]{background:var(--card,#fff);color:var(--primary,#b74424);box-shadow:0 2px 6px #0c1b3010}.ds-nav button:hover{background:var(--card,#fff)}.ds-nav button:focus-visible{outline:2px solid var(--primary,#b74424);outline-offset:4px}"},
    {"name":"Mode chip","kind":"chip","refersTo":"mode-chip","description":"Selected state follows the actual mode filter.","html":"<button class=\"ds-chip\" aria-pressed=\"true\">全部节点</button>","css":".ds-chip{padding:8px 14px;min-height:38px;border:1px solid var(--border,#dce1e8);border-radius:99px;background:transparent;color:var(--text-sec,#596579);font:500 12px system-ui;cursor:pointer}.ds-chip[aria-pressed=true]{background:var(--primary-soft,#f9ece5);color:var(--primary,#b74424);border-color:transparent}.ds-chip:hover{background:var(--card,#fff)}.ds-chip:focus-visible{outline:2px solid var(--primary,#b74424);outline-offset:4px}"},
    {"name":"Gallery selection","kind":"card","refersTo":"node-card","description":"Fixture title demonstrates the native node-selection button.","html":"<article class=\"ds-node\"><button aria-pressed=\"true\"><strong>日常观影</strong><span>/main</span></button></article>","css":".ds-node{padding:20px;border:1px solid var(--primary,#b74424);border-radius:20px;background:var(--card,#fff);color:var(--text,#202d40)}.ds-node button{display:flex;flex-direction:column;gap:4px;min-height:44px;padding:0;border:0;background:transparent;color:inherit;text-align:left;font:14px system-ui;cursor:pointer}.ds-node span{color:var(--text-sec,#596579);font:11px monospace}.ds-node:hover{box-shadow:0 10px 32px #1a2b400a}.ds-node button:focus-visible{outline:2px solid var(--primary,#b74424);outline-offset:4px}"}
